{
  "name": "real-estate-agency",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "node tooling/prepare.mjs",
    "dev": "node tooling/run-dev.mjs",
    "db:up": "docker compose up -d --wait postgres",
    "db:test:up": "docker compose --profile test up -d --wait postgres-test",
    "db:validate": "node tooling/database.mjs validate",
    "db:generate": "node tooling/database.mjs generate",
    "db:migrate": "node tooling/database.mjs migrate",
    "db:seed": "node tooling/database.mjs seed",
    "db:test:prepare": "node tooling/test-db.mjs",
    "contracts:generate": "pnpm --filter @agency/contracts --fail-if-no-match generate",
    "contracts:check": "pnpm --filter @agency/contracts --fail-if-no-match check:generated",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:architecture": "eslint apps/api/src apps/web/src apps/web/app --max-warnings 0 && depcruise apps/api/src apps/web/src --config .dependency-cruiser.cjs && node tooling/test-architecture.mjs",
    "build:shared": "node tooling/workspace.mjs shared",
    "typecheck": "node tooling/workspace.mjs typecheck",
    "test:unit": "node tooling/workspace.mjs test:unit",
    "test": "pnpm test:unit",
    "test:integration": "pnpm db:test:prepare && pnpm --filter @agency/api --fail-if-no-match test:integration",
    "test:e2e": "node tooling/run-e2e.mjs",
    "build": "node tooling/workspace.mjs build",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:architecture && pnpm contracts:check && pnpm test:unit",
    "verify": "pnpm db:validate && pnpm check && pnpm test:integration && pnpm test:e2e",
    "test:ops": "node tooling/test-ops.mjs",
    "test:docs": "node tooling/test-docs.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.0.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@eslint/js": "^10.0.0",
    "dependency-cruiser": "^17.0.0",
    "eslint": "^10.0.0",
    "eslint-config-next": "^16.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-boundaries": "^6.0.0",
    "eslint-plugin-fsd-lint": "^1.0.0",
    "globals": "^17.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^16.0.0",
    "next": "^16.4.6",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
