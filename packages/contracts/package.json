{
  "name": "@agency/contracts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/generated/paths.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "tsx scripts/generate.ts",
    "check:generated": "tsx scripts/generate.ts --check"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@agency/config": "workspace:*",
    "@types/node": "^24.0.0",
    "openapi-typescript": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  }
}
