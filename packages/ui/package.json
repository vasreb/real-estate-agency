    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.0",
    "clsx": "^2.0.0",
    "tailwind-merge": "^3.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@agency/config": "workspace:*",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^27.0.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  }
