# Local development only. Replace passwords before use. Never use this for production.
POSTGRES_PASSWORD=replace-local-database-password
POSTGRES_TEST_PASSWORD=replace-local-test-database-password
DATABASE_URL=postgresql://agency:replace-local-database-password@127.0.0.1:5432/agency
TEST_DATABASE_URL=postgresql://agency_test:replace-local-test-database-password@127.0.0.1:5433/agency_test
PUBLIC_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:3001
API_HOST=127.0.0.1
API_PORT=3001
# Proxies (IPs/CIDRs) whose X-Forwarded-For the API trusts; empty = socket address.
# Keep empty for `pnpm dev` (next dev does not rewrite X-Forwarded-For); set the
# address of apps/web/server.mjs (e.g. 127.0.0.1) only when running it.
TRUSTED_PROXIES=
# Edge proxies in front of the web server (empty = its TCP peer is the client).
WEB_TRUSTED_PROXIES=
SESSION_TTL_SECONDS=28800
LOG_LEVEL=info
SEED_ADMIN_PASSWORD=replace-local-admin-password
SEED_MEMBER_PASSWORD=replace-local-member-password
SEED_OTHER_PASSWORD=replace-local-other-password
# Indexing worker (apps/api/src/worker.ts): embeddings and OCR.
VOYAGE_API_KEY=replace-with-your-voyage-api-key
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIMENSIONS=1024
OCR_LANGUAGES=eng
