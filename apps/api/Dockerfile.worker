# syntax=docker/dockerfile:1
# Indexing worker (ADR-0008): same compiled API code, plus OCR and DOCX
# conversion tools. Build from the repository root:
#   docker build -f apps/api/Dockerfile.worker .
FROM node:24-slim AS build
WORKDIR /repo
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
COPY . .
ENV HUSKY=0
RUN pnpm install --frozen-lockfile \
 && DATABASE_URL=postgresql://build:build@127.0.0.1:5432/build pnpm --filter @agency/api db:generate \
 && pnpm --filter @agency/config --filter @agency/contracts build \
 && pnpm --filter @agency/api build

FROM node:24-slim AS runtime
WORKDIR /repo
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ocrmypdf tesseract-ocr tesseract-ocr-eng tesseract-ocr-rus \
      libreoffice-writer fonts-dejavu-core \
 && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@10.28.2 --activate
ENV NODE_ENV=production
COPY --from=build --chown=node:node /repo /repo
USER node
# Queue processing; `node apps/api/dist/worker.js --backfill` queues all
# documents that are not indexed yet and exits.
CMD ["node", "apps/api/dist/worker.js"]
