{
  "name": "@agency/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.unit.config.mjs --runInBand",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.integration.config.mjs --runInBand",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@agency/contracts": "workspace:*",
    "@anthropic-ai/sdk": "^1.9.0",
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "argon2": "^0.44.0",
    "fast-xml-parser": "^5.0.0",
    "fastify": "~5.12.8",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.0.0",
    "pino": "^10.0.0",
    "yauzl": "^3.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@agency/config": "workspace:*",
    "@swc/core": "^1.0.0",
    "@swc/jest": "^0.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "@types/supertest": "^6.0.0",
    "@types/yauzl": "^2.10.0",
    "jest": "^30.0.0",
    "prisma": "~7.10.1",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.3"
  }
}
